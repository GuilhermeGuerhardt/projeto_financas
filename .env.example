# ─── Banco de dados ──────────────────────────────────────────────────────────────
#
# IMPORTANTE — qual string copiar do Supabase:
#
# No painel: Connect (topo da página) -> aba "Session pooler".
#
#   Session pooler (porta 5432)  <- USE ESTA
#     postgresql://postgres.<ref>:<senha>@aws-<regiao>.pooler.supabase.com:5432/postgres
#     IPv4. É o modo recomendado para servidor Node persistente (como o Render).
#
#   Direct connection (db.<ref>.supabase.co:5432)  <- NÃO use no Render
#     É IPv6-only (IPv4 só com add-on pago). O Render faz saída IPv4, então
#     essa string falha lá com ENOTFOUND/ETIMEDOUT.
#
#   Transaction pooler (porta 6543)  <- NÃO use aqui
#     É para funções serverless/edge, não para servidor de longa duração.
#
DATABASE_URL=postgresql://postgres.SEU_REF:SUA_SENHA@aws-sa-east-1.pooler.supabase.com:5432/postgres

# ─── Autenticação ────────────────────────────────────────────────────────────────
#
# Segredo usado para assinar os tokens JWT. Gere uma string longa e aleatória:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Em produção o servidor se recusa a subir sem esta variável (backend/config.js).
# Trocar este valor invalida todas as sessões ativas.
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# ─── Servidor ────────────────────────────────────────────────────────────────────

# Porta local. No Render, a plataforma define PORT automaticamente — não configure lá.
PORT=3000

# Origem permitida para CORS. Como o Express serve o próprio front, em produção
# pode deixar em branco (mesma origem). Preencha só se um front externo consumir
# esta API, ex.: https://meuapp.com
CORS_ORIGIN=

# Define o modo de produção. Local, deixe em branco ou "development".
# No Render, o render.yaml já define NODE_ENV=production.
NODE_ENV=
