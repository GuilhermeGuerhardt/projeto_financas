# Conexão com o banco PostgreSQL (Supabase ou local)
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco

# Segredo para assinar os tokens JWT — troque por uma string longa e aleatória em produção
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Porta do servidor (padrão: 3000)
PORT=3000

# Origem permitida para CORS em produção (ex.: https://meuapp.com)
# Em desenvolvimento, deixe em branco para aceitar qualquer origem
CORS_ORIGIN=
